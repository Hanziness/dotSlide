{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate-ce-manifest"]
    },
    "dev": {
      "dependsOn": ["^build", "generate-ce-manifest"]
    },
    "generate-ce-manifest": {
      "cache": true,
      "outputs": ["custom-elements.json"]
    }
  }
}
