    "astro": "^5.17.1",
    "tsdown": "^0.22.4"
  },
  "peerDependencies": {
    "astro": "^4.0.0 || ^5.0.0 || ^6.0.0"
  },
  "dependencies": {
    "@dotslide/protocol": "workspace:*",
    "@lucide/astro": "^0.575.0",
    "nanostores": "^1.1.0",
    "zod": "^4.3.6"
