{
  "name": "@dotslide/framework",
  "version": "0.1.0",
  "author": {
    "name": "Imre Gera",
    "url": "https://github.com/Hanziness"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./widgets": "./widgets.ts",
    "./store": "./store.ts",
    "./layout": "./layout.ts",
    "./themes/*": "./themes/*"
  },
  "files": [
    "src",
    "themes",
    "index.ts",
    "widgets.ts",
    "layout.ts",
    "store.ts"
  ],
  "keywords": [
    "dotslide",
    "astro-component"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
