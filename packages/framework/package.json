{
  "name": "@dotslide/framework",
  "version": "0.2.0",
  "description": "Modern, framework-agnostic slideshow framework built for both humans and agents",
  "author": {
    "name": "Imre Gera",
    "url": "https://github.com/Hanziness"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hanziness/dotslide",
    "directory": "packages/framework"
  },
  "bugs": "https://github.com/Hanziness/dotslide/issues",
  "homepage": "https://github.com/Hanziness/dotslide#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dotslide.html-data.json": "./dotslide.html-data.json",
    "./themes/*": "./themes/*"
  },
  "files": [
    "dist",
    "themes",
    "dotslide.html-data.json"
  ],
  "keywords": [
    "dotslide",
    "presentation",
    "slides",
    "web-components",
    "framework-agnostic"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "tsdown": "^0.22.4",
    "@types/node": "^26.2.0"
  },
  "peerDependencies": {
    "zod": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@dotslide/protocol": "workspace:*",
    "nanostores": "^1.1.0"
  }
}
