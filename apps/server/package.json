{
  "name": "@dotslide/server",
  "version": "0.1.0",
  "description": "Controller server component for dotSlide presentations",
  "private": true,
  "type": "module",
  "author": {
    "name": "Imre Gera",
    "url": "https://github.com/Hanziness"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hanziness/dotslide",
    "directory": "apps/server"
  },
  "bugs": "https://github.com/Hanziness/dotslide/issues",
  "homepage": "https://github.com/Hanziness/dotslide#readme",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun run build.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.5.3",
    "@dotslide/protocol": "workspace:*",
    "@hono/zod-validator": "0.7.6",
    "better-auth": "1.5.3",
    "drizzle-orm": "0.45.1",
    "hono": "4.12.5",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "drizzle-kit": "0.31.9"
  },
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    }
  }
}
