---
import "../global.css";
import "@dotslide/framework/themes/default.css";
---

<ds-slideshow data-slideshow-width="1024" data-slideshow-height="768">
	<ds-keyboard-handler></ds-keyboard-handler>
	<ds-slide-controls></ds-slide-controls>
	<ds-loader></ds-loader>

	<!-- Title Slide -->
	<ds-slide class="flex flex-col items-center justify-center gap-4 bg-slate-100">
		<h1 class="font-bold text-xl">A Guide to Today's AI</h1>
		<div>John Doe</div>
	</ds-slide>

	<ds-slide>
		<p>Hi there</p>
	</ds-slide>

	<!-- Section: The basics -->
	<ds-section level="1" title="The basics"></ds-section>
	<ds-slide class="bg-slate-100">
		<div class="h-full px-16 flex flex-col items-center justify-center">
			<div><ds-current-section data-display="numeric" data-separator="." data-suffix="."></ds-current-section></div>
			<div class="w-full my-4 h-1 bg-black rounded-full" />
			<h2 class="text-lg font-bold text-left">The basics</h2>
		</div>
	</ds-slide>

	<ds-slide>
		<p>Oh look, another slide!</p>
		<p>Here's a test counter: <ds-counter data-type="test"></ds-counter></p>
	</ds-slide>

	<!-- Section: Introduction -->
	<ds-section level="2" title="Introduction"></ds-section>
	<ds-slide class="bg-slate-100">
		<div class="h-full px-16 flex flex-col items-center justify-center">
			<div><ds-current-section data-display="numeric" data-separator="." data-suffix="."></ds-current-section></div>
			<div class="w-full my-4 h-1 bg-black rounded-full" />
			<h2 class="text-lg font-bold text-left">Introduction</h2>
		</div>
	</ds-slide>

	<ds-slide>
		<p>The second test counter: <ds-counter data-type="test" data-id="test-2"></ds-counter>, but this one is a different one: <ds-counter data-type="table"></ds-counter></p>
		<p>Here's a row:</p>
		<ds-flex>
			<ds-item>One</ds-item>
			<ds-item>Two</ds-item>
		</ds-flex>

		<p>And these are two lists:</p>
		<ds-list data-mode="unordered">
			<ds-list-item>Item 1</ds-list-item>
			<ds-list-item>Item 2</ds-list-item>
		</ds-list>

		<ds-list data-mode="ordered" style="--ds-list-start: 3">
			<ds-list-item>Item 3</ds-list-item>
			<ds-list-item>Item 4</ds-list-item>
		</ds-list>

		<p class="mt-8">And this is a column:</p>
		<ds-flex mode="column">
			<div>One</div>
			<div>Two</div>
		</ds-flex>
	</ds-slide>

	<ds-slide>
		<p>Let's see if <ds-reference data-id="test-2"></ds-reference> exists.</p>
	</ds-slide>
</ds-slideshow>

<script>
	import "@dotslide/framework";
</script>